import "./types.ilk"
import "./events.ilk"
import "./tags.ilk"
import "./actors.ilk"


viewProductsInventories = ViewSlice {
    name "ViewProductsInventories"
    description "The shopper sees how many units of a product are in stock."

    actor userActor

    image "./mockups/view_inventories.png"

    endpoint {
        method GET
        path "/inventories/products/{sku}"
        params {sku Uuid}
        responses []
    }

    query [
        {
            eventTypes [inventoryChanged]
            tags [productIdTag]
        }
    ]

    readModel {
        sku Uuid
        inventory Int
    }

    scenarios []
}
