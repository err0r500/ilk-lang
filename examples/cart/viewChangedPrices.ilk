import "./types.ilk"
import "./events.ilk"
import "./tags.ilk"
import "./actors.ilk"


changedPrices = ViewSlice {
    name "ChangedPrices"
    description "The shopper sees how the price of a product evolved."

    actor userActor

    endpoint {
        method GET
        path "/prices/products/{sku}"
        params {sku Uuid}
        responses []
    }

    query [
        {
            eventTypes [priceChanged]
            tags [productIdTag]
        }
    ]

    readModel {
        changes [{
            sku Uuid
            oldPrice Money
            newPrice Money
        }]
    }

    scenarios []
}
