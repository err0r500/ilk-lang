import "./types.ilk"
import "./events.ilk"
import "./tags.ilk"
import "./actors.ilk"


clearCart = ChangeSlice {
    name "ClearCart"

    description "The shopper empties their cart in one go."

    actor userActor

    endpoint {
        method DELETE
        path "/carts/{cartId}/items"
        params {cartId Uuid}
        auth {userId Uuid}

        responses []
    }

    command {
        fields {
            cartId Uuid
            shopperId Uuid = endpoint.auth.userId
        }

        query [
            {
                eventTypes [cartCreated]
                tags [cartIdTag]
            }
        ]

        emits [cartCleared]
    }

    // the cart's owner, recorded when the cart was created
    requires ["shopperId"]

    invariants []

    scenarios [
        {
            name "OK: clear a cart"
            given [cartCreated & {fields {cartId "abc"}}]
            when {cartId "abc"}
            then [cartCleared]
        }
        {
            name "Err: unknown cart"
            given []
            when {cartId "abc"}
            then {error "cart not found"}
        }
    ]
}
