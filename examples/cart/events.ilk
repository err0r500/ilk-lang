import "./types.ilk"
import "./tags.ilk"


cartCreated = TaggedEvent {
    type "CartCreated"
    description "A shopper opened a new cart."

    fields {
        cartId Uuid
        shopperId Uuid
    }

    tags [
        cartIdTag
        shopperIdTag
        cartTag & {cart Uuid = fields.cartId}
    ]
}


itemAdded = TaggedEvent {
    type "itemAdded"
    description "A product was put in a cart, at the price shown at that moment."

    fields {
        cartId Uuid
        itemId Uuid
        sku Uuid
        price Int
        quantity Int
    }

    tags [cartIdTag]
}


itemRemoved = TaggedEvent {
    type "ItemRemoved"
    description "An item was taken out of a cart."

    fields {
        cartId Uuid
        itemId Uuid
    }

    tags [cartIdTag]
}


cartCleared = TaggedEvent {
    type "CartCleared"
    description "All items of a cart were removed at once."

    fields {cartId Uuid}

    tags [cartIdTag]
}


cartSubmitted = TaggedEvent {
    type "CartSubmitted"
    description "The shopper submitted the cart for checkout."

    fields {
        cartId Uuid
        shopperId Uuid
    }

    tags [
        cartIdTag
        shopperIdTag
    ]
}


inventoryChanged = TaggedEvent {
    type "InventoryChanged"
    description "The stock level of a product changed (from the warehouse)."

    fields {
        sku Uuid
        inventory Int
    }

    tags [productIdTag]
}


priceChanged = TaggedEvent {
    type "PriceChanged"
    description "The catalog price of a product changed."

    fields {
        productId Uuid
        oldPrice Int
        newPrice Int
    }

    tags [productIdTag & {sku Uuid = fields.productId}]
}
