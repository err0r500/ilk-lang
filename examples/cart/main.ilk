import "./types.ilk"
import "./cmdAddItem.ilk"
import "./cmdClearCart.ilk"
import "./cmdRemoveItem.ilk"
import "./viewCartItems.ilk"
import "./viewChangedPrices.ilk"
import "./viewProductsInventories.ilk"
import "./transSyncInventory.ilk"
import "./transSyncPrices.ilk"
// import "./viewOpenCartsWithProducts.ilk"


@main
board = Board {
    name "Shopping Cart"
    description "Event model of an e-commerce shopping cart"

    contexts [{
        name "Shopping"
        description "Shopping Cart Context"
        chapters [
            {
                name "Cart Items"
                description "Customer browses products and fills their cart"
                slices [
                    addItem
                    removeItem
                    clearCart
                    viewCartItems
                ]
            }
            {
                name "Catalog"
                description "Stock levels and prices come from other systems"
                slices [
                    syncInventory
                    syncPrices
                    viewProductsInventories
                    changedPrices
                ]
            }
        ]
    }]

    // the graph of possible journeys: from a slice, which slices can come next
    flows [
        {from addItem, to [viewCartItems]}
        {from viewCartItems, to [addItem, removeItem, clearCart]}
        {from removeItem, to [viewCartItems]}
        {from clearCart, to [viewCartItems]}
        {from syncInventory, to [viewProductsInventories, addItem]}
        {from syncPrices, to [changedPrices]}
    ]

    openEndedStreams [shopperIdTag, productIdTag]
}
