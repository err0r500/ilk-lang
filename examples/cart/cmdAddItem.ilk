import "./types.ilk"
import "./events.ilk"
import "./tags.ilk"
import "./actors.ilk"


addItem = ChangeSlice {
    name "AddItem"

    description "The shopper adds a product to their cart.
The cart is opened automatically on the first item.
A cart holds at most 3 items, and out-of-stock products can't be added."

    actor userActor

    entryScreen "product page"

    endpoint {
        method POST
        path "/carts/{cartId}/items"
        params {cartId Uuid}

        auth {userId Uuid}

        body {
            sku Uuid
            price Money
            quantity Int

            description String
            imageURL String
        }

        responses []
    }

    command {
        fields {
            itemId Uuid*
            shopperId Uuid = endpoint.auth.userId
            cartId Uuid
            sku Uuid

            price Money
            quantity Int
            description String
            imageURL String
        }

        query [
            {
                eventTypes [cartCreated]
                tags [
                    cartIdTag
                    shopperIdTag
                ]
            }
            {
                eventTypes [itemAdded]
                tags [cartIdTag]
            }
            {
                eventTypes [inventoryChanged]
                tags [productIdTag]
            }
        ]

        emits [
            cartCreated
            itemAdded
        ]
    }

    requires []

    invariants [
        "a cart holds at most 3 items"
        "only products in stock can be added"
    ]

    scenarios [
        {
            name "OK: Add item automatically opens the cart"
            given [cartCreated & {fields {cartId "abc"}}]
            when {}
            then [
                cartCreated
                itemAdded
            ]
        }
        {
            name "OK: Add item"
            given [
                cartCreated & {fields {cartId "abc"}}
                itemAdded & {fields {cartId "abc"}}
            ]
            when {}
            then [itemAdded]
        }
        {
            name "Err: duplicate cart creation"
            given [cartCreated & {fields {cartId "abc"}}]
            when {cartId "abc"}
            then {error "already created"}
        }
        {
            name "Err: 2 carts can't have the same Id"
            given [cartCreated & {fields {cartId "abc"}}]
            when {cartId "abc"}
            then {error "conflict"}
        }
        {
            name "Err: max 3 items per cart"
            given [
                cartCreated
                itemAdded
                itemAdded
                itemAdded
            ]
            when {}
            then {error "can't add more than 3 items"}
            violates "a cart holds at most 3 items"
        }
        {
            name "Err: can't add item if empty inventory"
            given [
                cartCreated
                inventoryChanged & {fields {
                    sku "abc"
                    inventory 0
                }}
            ]
            when {}
            then {error "product out of stock"}
            violates "only products in stock can be added"
        }
    ]
}
